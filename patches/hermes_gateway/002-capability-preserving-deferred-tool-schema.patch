+
+    assert payload["truncated"] is True
+    assert payload["continuation_ref"] == "files:find"
+    assert len(payload["preview"]) == 100
+
+
+def test_no_final_answer_before_tools_guard_is_structured() -> None:
+    blocked = final_answer_allowed_for_external_task(
+        expected_bundles=["files_discover"],
+        loaded_bundles=[],
+        tool_used=False,
+    )
+    allowed = final_answer_allowed_for_external_task(
+        expected_bundles=["files_discover"],
+        loaded_bundles=["files_discover"],
+        tool_used=True,
