+from __future__ import annotations
+
+import json
+
+from gateway.memory_answer_renderer import render_memory_answer
+from gateway.turn_profiles import resolve_turn_profile
+from hermes_deferred_tools import (
+    build_tool_loader_quality,
+    classify_fallback_threshold,
+    final_answer_allowed_for_external_task,
+    select_tool_schemas,
+)
+
+
+def _tool(name: str) -> dict:
+    return {
+        "type": "function",
+        "function": {
+            "name": name,
+            "description": name,
+            "parameters": {"type": "object", "properties": {}},
+        },
+    }
+
+
+def test_rc_default_discord_capability_preserved() -> None:
+    resolved = resolve_turn_profile(
+        platform="discord",
+        prompt="find the .md files",
+        current_enabled_toolsets=["file", "terminal", "web"],
+        env={},
+    )
+
+    data = resolved.to_dict()["capability_preservation"]
+    assert resolved.enabled_toolsets == ("file", "terminal", "web")
+    assert data["capability_shrunk"] is False
+    assert data["runtime_capability_health"]["filesystem.search_read"] == "available"
+    assert data["runtime_capability_health"]["terminal.execute"] == "available_requires_approval"
+    assert data["runtime_capability_health"]["web.browse"] == "available"
+
+
+def test_rc_renderer_negative_filesystem_task_falls_back() -> None:
+    answer = render_memory_answer(
+        turn_contract={
+            "allowed_tool_profile": "existing_platform_default",
+            "external_capability_required_for_memory_answer": False,
+        },
+        answerability={
+            "state": "unanswerable",
+            "max_claim_strength": "none",
+            "answer_type": "none",
+            "answer_evidence_count": 0,
+        },
+        answer_evidence=[],
+    )
+
+    assert answer.used_renderer is False
+    assert answer.fallback_reason == "generic_no_evidence_forbidden"
+
+
+def test_rc_normal_discord_find_markdown_fixture_loads_and_uses_files_discover() -> None:
+    available = {"search_files": _tool("search_files"), "read_file": _tool("read_file")}
+    selection = select_tool_schemas(
+        {
+            "request_id": "find-md",
+            "intent_summary": "Find markdown files in the project.",
+            "bundle_ids": ["files_discover"],
+            "lifetime": "ephemeral_turn",
+        },
+        available,
+        already_loaded={"load_tools"},
+    )
+    loaded_bundles = ["files_discover"] if selection.loaded else []
+    guard = final_answer_allowed_for_external_task(
+        expected_bundles=["files_discover"],
+        loaded_bundles=loaded_bundles,
+        tool_used=bool(selection.loaded),
