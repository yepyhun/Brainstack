+def _answer_evidence_from_selected(
+    answerability: Mapping[str, Any],
+    selected_evidence: Any,
+) -> List[Dict[str, Any]]:
+    ids = answerability.get("answer_evidence_ids") or answerability.get("evidence_ids") or ()
+    if isinstance(ids, str):
+        wanted = {ids}
+    else:
+        wanted = {str(item) for item in ids if item}
+    if not isinstance(selected_evidence, Mapping):
+        return []
+
+    flattened: List[Dict[str, Any]] = []
+    for rows in selected_evidence.values():
+        if not isinstance(rows, list):
+            continue
+        for row in rows:
+            if isinstance(row, Mapping):
+                item = dict(row)
+                flattened.append(item)
+
+    if not wanted:
+        return flattened[:1] if int(answerability.get("answer_evidence_count", 0) or 0) == 1 else []
+
+    matched: List[Dict[str, Any]] = []
+    for item in flattened:
+        keys = (
+            item.get("evidence_id"),
+            item.get("id"),
+            item.get("candidate_id"),
+            item.get("stable_key"),
+            item.get("row_id"),
+            item.get("slot_id"),
+        )
+        if any(str(key) in wanted for key in keys if key):
+            matched.append(item)
+    return matched
+
