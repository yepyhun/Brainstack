+    def direct_render_preflight(self, query: str, *, session_id: str = "") -> Optional[Dict[str, Any]]:
+        """Return structured memory evidence for Hermes direct rendering.
+
+        Providers do not decide routing, model, tools, or renderer use. This
+        method only exposes answerability/evidence in a stable shape so Hermes
+        runtime can compile its own RenderPlan.
+        """
+        if not query or not query.strip():
+            return None
+        for provider in self._providers:
+            query_inspect = getattr(provider, "query_inspect", None)
+            if not callable(query_inspect):
+                continue
+            try:
+                report = query_inspect(query=query, session_id=session_id)
+            except Exception as e:
+                logger.debug(
+                    "Memory provider '%s' direct render preflight failed: %s",
+                    provider.name,
+                    e,
+                )
+                continue
+            if not isinstance(report, dict):
+                continue
+            answerability = report.get("memory_answerability")
+            if not isinstance(answerability, dict):
+                continue
+            selected = report.get("selected_evidence")
+            evidence = _answer_evidence_from_selected(answerability, selected)
+            return {
+                "schema": "hermes.memory_direct_render_preflight.v1",
+                "provider": provider.name,
+                "answerability": dict(answerability),
+                "answer_evidence": evidence,
+                "capability_health": dict(report.get("capability_health") or {}),
+                "source": "memory_provider_query_inspect",
+            }
+        return None
