+from run_agent import AIAgent
+
+
+def _tool(name: str) -> dict:
+    return {
+        "type": "function",
+        "function": {
+            "name": name,
+            "description": f"{name} schema",
+            "parameters": {"type": "object", "properties": {}},
+        },
+    }
+
+
+def _agent(tool_defs: list[dict]) -> AIAgent:
+    with (
+        patch("run_agent.get_tool_definitions", return_value=tool_defs),
+        patch("run_agent.check_toolset_requirements", return_value={}),
+        patch("run_agent.OpenAI"),
+        patch("hermes_cli.config.load_config", return_value={}),
+    ):
+        return AIAgent(
+            api_key="test-key",
+            model="test-model",
+            base_url="https://example.test/v1",
+            quiet_mode=True,
+            skip_context_files=True,
+            skip_memory=True,
+            enabled_toolsets=["file"],
+            deferred_tool_schema_mode=True,
+        )
+
+
+def test_deferred_mode_initializes_load_tools_only() -> None:
+    agent = _agent([_tool("search_files"), _tool("read_file"), _tool("write_file")])
+
+    assert [tool["function"]["name"] for tool in agent.tools] == [LOAD_TOOLS_NAME]
+    assert agent.valid_tool_names == {LOAD_TOOLS_NAME}
+    assert "search_files" in agent._deferred_available_tool_defs_by_name
+    assert agent._tool_loader_trace["capability_shrunk"] is False
+
+
+def test_load_tools_loads_bundle_and_continuation() -> None:
+    agent = _agent([_tool("search_files"), _tool("read_file"), _tool("write_file")])
+
+    raw = agent._handle_deferred_tool_load(
+        {
+            "request_id": "load-md",
+            "intent_summary": "Find markdown files in the project.",
+            "bundle_ids": ["files_discover"],
+            "lifetime": "ephemeral_turn",
+        }
+    )
+    result = json.loads(raw)
+
+    assert result["status"] == "loaded"
+    assert result["capability_preserved"] is True
+    assert result["continuation"]["must_continue_original_task"] is True
+    assert result["continuation"]["must_not_answer_from_memory_only"] is True
+    assert result["loaded"][0]["tool_name"] == "search_files"
+    assert "search_files" in agent.valid_tool_names
+    assert "read_file" not in agent.valid_tool_names
+
+
+def test_tool_loader_schema_contains_no_unavailable_instruction() -> None:
+    catalog = build_capability_catalog(
+        enabled_toolsets=["file"],
+        tool_defs=[_tool("search_files")],
+    )
+    schema = build_load_tools_schema(catalog)
+    description = schema["function"]["description"]
+
+    assert "Do not answer that the capability is unavailable" in description
+    assert "does not grant new capability or approval" in description
+
+
+def test_model_facing_result_cap_uses_continuation_ref() -> None:
+    capped = cap_model_facing_result("x" * 6000, max_chars=100, continuation_ref="files:find")
