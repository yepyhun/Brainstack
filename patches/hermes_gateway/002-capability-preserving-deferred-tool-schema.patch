new file mode 100644
index 00000000..36430d24
--- /dev/null
+++ b/hermes_deferred_tools.py
@@ -0,0 +1,422 @@
+"""Hermes capability-preserving deferred tool schema support.
+
+This module owns schema loading metadata only. It does not execute tools,
+grant approval, choose models, or write memory.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+import hashlib
+import json
+from typing import Any, Mapping, Sequence
+
+
+LOAD_TOOLS_NAME = "load_tools"
+
+TOOL_SEARCH_BACKENDS = ("client_executed", "openai_hosted", "anthropic_tool_search", "full_fallback")
+
+BUNDLE_TO_TOOLS: dict[str, tuple[str, ...]] = {
+    "memory": ("memory",),
+    "session": ("session_search",),
+    "files_discover": ("search_files",),
+    "files_read": ("read_file",),
+    "files_write": ("write_file", "patch"),
+    "web_discover": ("web_search",),
+    "web_read": ("web_extract", "browser_navigate", "browser_snapshot"),
+    "attachments_read": ("vision_analyze", "read_file"),
+    "terminal_status": ("process",),
+    "terminal_execute": ("terminal",),
+    "code_inspect": ("search_files", "read_file"),
+    "workflow_state": ("todo", "clarify"),
+}
+
+CAPABILITY_TO_BUNDLES: dict[str, tuple[str, ...]] = {
+    "memory.recall": ("memory",),
+    "session.search": ("session",),
+    "filesystem.search_read": ("files_discover", "files_read"),
+    "filesystem.write": ("files_write",),
+    "terminal.status": ("terminal_status",),
+    "terminal.execute": ("terminal_execute",),
+    "web.browse": ("web_discover", "web_read"),
+    "documents.attachments": ("attachments_read",),
+    "code.inspect": ("code_inspect",),
+    "workflow.state": ("workflow_state",),
+}
+
+SIDE_EFFECT_TOOLS = {"write_file", "patch", "terminal"}
+DEFAULT_SCHEMA_BUDGET = {"max_pinned_schema_tokens": 3000, "max_pinned_tools": 8}
+DEFAULT_RESULT_CAP = {"max_items": 50, "max_tokens": 1200}
+
+
+@dataclass(frozen=True)
+class ToolLoadSelection:
+    loaded: tuple[dict[str, Any], ...]
+    not_loaded: tuple[dict[str, str], ...]
+    requested_bundles: tuple[str, ...]
+    requested_capabilities: tuple[str, ...]
+
+
+def schema_token_estimate(tool_def: Mapping[str, Any]) -> int:
+    return max(1, len(json.dumps(tool_def, sort_keys=True, default=str)) // 4)
+
+
+def configured_toolset_hash(tool_defs: Sequence[Mapping[str, Any]]) -> str:
+    names = sorted(
+        str(tool.get("function", {}).get("name", ""))
+        for tool in tool_defs
+        if isinstance(tool, Mapping)
+    )
+    return "sha256:" + hashlib.sha256("\n".join(names).encode()).hexdigest()
+
+
+def bundle_for_tool(tool_name: str) -> str:
+    for bundle_id, tool_names in BUNDLE_TO_TOOLS.items():
+        if tool_name in tool_names:
+            return bundle_id
+    return "unknown"
+
+
+def effect_class_for_tool(tool_name: str) -> str:
+    if tool_name in {"write_file", "patch"}:
+        return "local_write"
+    if tool_name == "terminal":
+        return "execute"
+    if tool_name in {"web_search", "web_extract", "browser_navigate"}:
+        return "network"
+    return "read_only"
+
+
+def approval_required_for_tool(tool_name: str) -> bool:
+    return tool_name in SIDE_EFFECT_TOOLS
+
+
+def build_capability_catalog(
+    *,
+    enabled_toolsets: Sequence[str],
+    tool_defs: Sequence[Mapping[str, Any]],
+    highlighted_bundles: Sequence[str] = (),
+) -> dict[str, Any]:
+    available_names = {
+        str(tool.get("function", {}).get("name", ""))
+        for tool in tool_defs
+        if isinstance(tool, Mapping)
+    }
+    highlighted = set(highlighted_bundles)
+    capabilities = []
+    for capability_id, bundle_ids in CAPABILITY_TO_BUNDLES.items():
+        matching_tools = sorted(
+            tool_name
+            for bundle_id in bundle_ids
+            for tool_name in BUNDLE_TO_TOOLS.get(bundle_id, ())
+            if tool_name in available_names
+        )
+        if not matching_tools:
+            continue
+        first_bundle = next((b for b in bundle_ids if any(t in available_names for t in BUNDLE_TO_TOOLS.get(b, ()))), bundle_ids[0])
+        capabilities.append(
+            {
+                "capability_id": capability_id,
+                "bundle_ids": list(bundle_ids),
+                "preferred_bundle_id": first_bundle,
+                "label": _capability_label(capability_id),
+                "summary": _capability_summary(capability_id),
+                "schema_loaded": False,
+                "risk": _capability_risk(capability_id),
+                "approval": "required" if any(approval_required_for_tool(t) for t in matching_tools) else "not_required",
+                "highlighted": bool(highlighted & set(bundle_ids)),
+            }
+        )
+    capabilities.sort(key=lambda item: (not item["highlighted"], item["capability_id"]))
+    return {
+        "catalog_version": "hermes.capability_catalog.v1",
+        "configured_capabilities_preserved": True,
+        "instruction": (
+            "If the user asks for a listed capability and its schema is not loaded, "
+            "call load_tools or ask clarification. Do not answer that the capability "
+            "is unavailable unless CapabilityManifest marks it unavailable."
+        ),
+        "configured_toolsets": list(enabled_toolsets),
+        "configured_toolset_hash": configured_toolset_hash(tool_defs),
+        "schema_budget": DEFAULT_SCHEMA_BUDGET,
+        "capabilities": capabilities,
+    }
+
+
+def build_load_tools_schema(catalog: Mapping[str, Any]) -> dict[str, Any]:
+    capability_ids = sorted(CAPABILITY_TO_BUNDLES)
+    bundle_ids = sorted(BUNDLE_TO_TOOLS)
+    description = (
+        "Load full schemas for already-configured Hermes capabilities. "
+        "This does not grant new capability or approval. "
+        + str(catalog.get("instruction", ""))
+        + "\nCompact capability catalog:\n"
+        + json.dumps(catalog, ensure_ascii=False, separators=(",", ":"))[:5000]
+    )
+    return {
+        "type": "function",
+        "function": {
+            "name": LOAD_TOOLS_NAME,
+            "description": description,
+            "parameters": {
+                "type": "object",
+                "properties": {
+                    "request_id": {"type": "string"},
+                    "intent_summary": {"type": "string"},
+                    "capability_ids": {"type": "array", "items": {"type": "string", "enum": capability_ids}},
+                    "bundle_ids": {"type": "array", "items": {"type": "string", "enum": bundle_ids}},
+                    "tool_names": {"type": "array", "items": {"type": "string"}},
+                    "lifetime": {
+                        "type": "string",
+                        "enum": ["ephemeral_turn", "pinned_until_task_end", "pinned_until_session_end"],
+                    },
+                    "operation_class": {
+                        "type": "string",
+                        "enum": ["read_only", "write_or_modify", "execute", "network", "unknown"],
+                    },
+                    "requires_side_effect": {"type": "boolean"},
+                },
+                "required": ["request_id", "intent_summary", "lifetime"],
+                "additionalProperties": False,
+            },
+        },
+    }
+
+
+def select_tool_schemas(
+    request: Mapping[str, Any],
+    available_tool_defs_by_name: Mapping[str, Mapping[str, Any]],
+    *,
+    already_loaded: set[str] | None = None,
+) -> ToolLoadSelection:
+    already_loaded = already_loaded or set()
+    requested_capabilities = _string_tuple(request.get("capability_ids"))
+    requested_bundles = _string_tuple(request.get("bundle_ids"))
+    requested_tools = set(_string_tuple(request.get("tool_names")))
+    for capability_id in requested_capabilities:
+        for bundle_id in CAPABILITY_TO_BUNDLES.get(capability_id, ()):
+            requested_bundles += (bundle_id,)
+    selected_names = set(requested_tools)
+    for bundle_id in requested_bundles:
+        selected_names.update(BUNDLE_TO_TOOLS.get(bundle_id, ()))
+    loaded: list[dict[str, Any]] = []
+    not_loaded: list[dict[str, str]] = []
+    for name in sorted(selected_names):
+        if name == LOAD_TOOLS_NAME or name in already_loaded:
+            continue
+        tool_def = available_tool_defs_by_name.get(name)
+        if not tool_def:
+            not_loaded.append({"tool_name": name, "reason": "not_configured_or_unavailable"})
+            continue
+        loaded.append(dict(tool_def))
+    return ToolLoadSelection(
+        loaded=tuple(loaded),
+        not_loaded=tuple(not_loaded),
+        requested_bundles=tuple(sorted(set(requested_bundles))),
+        requested_capabilities=tuple(sorted(set(requested_capabilities))),
+    )
+
+
+def build_tool_load_result(
+    *,
+    request: Mapping[str, Any],
+    selection: ToolLoadSelection,
+    configured_hash: str,
+    original_turn_id: str | None = None,
+    original_user_message_hash: str | None = None,
+) -> dict[str, Any]:
+    loaded = []
+    for tool_def in selection.loaded:
+        name = str(tool_def.get("function", {}).get("name", ""))
+        loaded.append(
+            {
+                "tool_name": name,
+                "capability_id": _capability_for_bundle(bundle_for_tool(name)),
+                "bundle_id": bundle_for_tool(name),
+                "risk": effect_class_for_tool(name),
+                "approval_required": approval_required_for_tool(name),
+                "schema_ref": f"tool_schema:{name}",
+                "schema_tokens_est": schema_token_estimate(tool_def),
+            }
+        )
+    return {
+        "schema": "hermes.tool_loader.result.v1",
+        "request_id": str(request.get("request_id") or ""),
+        "status": "loaded" if loaded else "no_matching_tools",
+        "capability_preserved": True,
+        "loaded": loaded,
+        "not_loaded": list(selection.not_loaded),
+        "approval": {
+            "required_for_loaded_tools": any(item["approval_required"] for item in loaded),
+            "required_for_side_effects": True,
+            "schema_loading_grants_approval": False,
+            "approval_service": "gateway_approval",
+        },
+        "lifetime": str(request.get("lifetime") or "ephemeral_turn"),
+        "continuation": {
+            "continuation_schema": "hermes.tool_load_continuation.v1",
+            "original_turn_id": original_turn_id,
+            "original_user_message_hash": original_user_message_hash,
+            "original_task_summary": str(request.get("intent_summary") or ""),
+            "loaded_bundles": sorted({item["bundle_id"] for item in loaded}),
+            "loaded_tools": [item["tool_name"] for item in loaded],
+            "must_continue_original_task": True,
+            "must_not_answer_from_memory_only": True,
+            "capability_preservation": {"capability_shrunk": False},
+        },
+        "trace": {
+            "tool_loader_call_id": "tlc_" + hashlib.sha256(json.dumps(request, sort_keys=True, default=str).encode()).hexdigest()[:12],
+            "configured_toolset_hash": configured_hash,
+            "loaded_schema_tokens_est": sum(item["schema_tokens_est"] for item in loaded),
+            "loader_reason_code": "MODEL_REQUESTED_DEFERRED_SCHEMAS",
+        },
+    }
+
+
+def cap_model_facing_result(content: str, *, max_chars: int = 4800, continuation_ref: str | None = None) -> str:
+    if len(content) <= max_chars:
+        return content
+    ref = continuation_ref or "tool_result:" + hashlib.sha256(content.encode(errors="ignore")).hexdigest()[:12]
+    payload = {
+        "truncated": True,
+        "total_chars": len(content),
+        "preview": content[:max_chars],
+        "continuation_ref": ref,
+        "next_actions": ["narrow_query", "request_specific_range"],
+    }
+    return json.dumps(payload, ensure_ascii=False)
+
+
+def final_answer_allowed_for_external_task(
+    *,
+    expected_bundles: Sequence[str],
+    loaded_bundles: Sequence[str],
+    tool_used: bool,
+    clarification_asked: bool = False,
+    capability_unavailable: bool = False,
+    approval_requested: bool = False,
+) -> dict[str, Any]:
+    """Fixture/canary guard: external task cannot finalize before tool path.
+
+    Production callers must pass structured expectation from contract/canary state,
+    not infer it from language keywords.
+    """
+
+    expected = {str(item) for item in expected_bundles if str(item)}
+    loaded = {str(item) for item in loaded_bundles if str(item)}
+    missing = sorted(expected - loaded)
+    allowed = (
+        not expected
+        or (not missing and tool_used)
+        or clarification_asked
+        or capability_unavailable
+        or approval_requested
+    )
+    return {
+        "external_capability_possible": bool(expected),
+        "expected_bundles": sorted(expected),
+        "loaded_required_bundle": not missing if expected else True,
+        "missing_bundles": missing,
+        "tool_used": bool(tool_used),
+        "final_answer_allowed": bool(allowed),
+        "reason": "OK" if allowed else "EXTERNAL_TASK_WITHOUT_REQUIRED_TOOL_PATH",
+        "keyword_router_used": False,
+    }
+
+
+def build_tool_loader_quality(
+    *,
+    expected_bundles: Sequence[str],
+    loaded_bundles: Sequence[str],
+    used_loaded_tool: bool,
+    false_no_access: bool,
+    full_fallback_used: bool,
+) -> dict[str, Any]:
+    expected = {str(item) for item in expected_bundles if str(item)}
+    loaded = {str(item) for item in loaded_bundles if str(item)}
+    return {
+        "tool_load_expected": bool(expected),
+        "expected_bundles": sorted(expected),
+        "loaded_bundles": sorted(loaded),
+        "tool_load_recall_pass": expected.issubset(loaded) if expected else True,
+        "irrelevant_bundle_count": len(loaded - expected) if expected else len(loaded),
+        "used_loaded_tool": bool(used_loaded_tool),
+        "false_no_access": bool(false_no_access),
+        "full_fallback_used": bool(full_fallback_used),
+    }
+
+
+def classify_fallback_threshold(
+    *,
+    fallback_count: int,
+    canary_count: int,
+    hidden_capability_denial: bool = False,
+) -> dict[str, Any]:
+    if hidden_capability_denial:
+        verdict = "BLOCKED"
+        reason = "P0_FALLBACK_HID_CAPABILITY_DENIAL"
+    elif canary_count > 0 and (fallback_count / canary_count) > 0.05:
+        verdict = "BLOCKED"
+        reason = "P1_FALLBACK_RATE_ABOVE_5_PERCENT"
+    elif fallback_count > 0:
+        verdict = "CONDITIONAL"
+        reason = "P2_FALLBACK_PRESERVED_CAPABILITY_ROOT_CAUSE_REQUIRED"
+    else:
+        verdict = "READY"
+        reason = "NO_FALLBACK"
+    return {
+        "fallback_count": int(fallback_count),
+        "canary_count": int(canary_count),
+        "fallback_rate": (fallback_count / canary_count) if canary_count else 0.0,
+        "hidden_capability_denial": bool(hidden_capability_denial),
+        "verdict": verdict,
+        "reason": reason,
+    }
+
+
+def _string_tuple(value: Any) -> tuple[str, ...]:
+    if isinstance(value, str):
+        return (value,)
+    if isinstance(value, Sequence):
+        return tuple(str(item) for item in value if str(item))
+    return ()
+
+
+def _capability_for_bundle(bundle_id: str) -> str:
+    for capability_id, bundle_ids in CAPABILITY_TO_BUNDLES.items():
+        if bundle_id in bundle_ids:
+            return capability_id
+    return "unknown"
+
+
+def _capability_label(capability_id: str) -> str:
+    return {
+        "memory.recall": "Recall Brainstack/Hermes memory",
+        "session.search": "Search prior sessions",
+        "filesystem.search_read": "Find and read files",
+        "filesystem.write": "Modify files",
+        "terminal.status": "Inspect terminal/runtime status",
+        "terminal.execute": "Run shell commands",
+        "web.browse": "Search or inspect web content",
+        "documents.attachments": "Inspect attachments",
+        "code.inspect": "Inspect source code",
+        "workflow.state": "Inspect workflow state",
+    }.get(capability_id, capability_id)
+
+
+def _capability_summary(capability_id: str) -> str:
+    return {
+        "filesystem.search_read": "List, find, open, and inspect local/project files available to Hermes.",
+        "terminal.execute": "Execute configured terminal commands; approval may be required by runtime policy.",
+        "web.browse": "Use configured web/search/browser tools for current external information.",
+    }.get(capability_id, "Load configured Hermes tool schemas for this capability.")
+
+
+def _capability_risk(capability_id: str) -> str:
+    if capability_id in {"filesystem.write", "terminal.execute"}:
+        return "side_effect"
+    if capability_id in {"filesystem.search_read", "documents.attachments", "session.search"}:
+        return "read_only_private_data"
+    if capability_id == "web.browse":
+        return "external_network"
+    return "read_only"
