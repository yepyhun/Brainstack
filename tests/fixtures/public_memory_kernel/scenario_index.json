      "forbidden_regression": "partial_coverage_allows_full_ack",
      "required_trace_reason_code": "full_ack_requires_complete_receipt_coverage",
      "expected_oracle": "contract_and_trace",
      "does_not_contain_private_data": true
    },
    {
      "scenario_id": "assistant_contamination_public_001",
