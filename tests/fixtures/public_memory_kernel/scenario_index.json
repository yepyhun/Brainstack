{
  "schema": "brainstack.public_memory_kernel.scenario_index.v1",
  "oracle_policy": "contract_and_trace_first",
  "private_data_policy": {
    "raw_private_data_allowed": false,
    "blocked_static_marker_patterns": [
      "local_absolute_home_path",
      "discord_channel_url",
      "private_runtime_container_name",
      "private_repository_owner_literal"
    ],
    "blocked_secret_patterns": [
      "discord_bot_or_user_token",
      "openai_style_secret_key",
      "github_personal_access_token"
    ]
  },
  "scenarios": [
    {
      "scenario_id": "explicit_capture_complete_public_001",
      "fixture": "conversations/explicit_capture_complete_public_001.json",
      "represents_private_failure_class": "receipt_backed_explicit_capture_reset_recall",
      "invariant": "full memory acknowledgement requires complete receipt coverage",
      "forbidden_regression": "full_ack_without_complete_receipt_coverage",
      "required_trace_reason_code": "selected_receipt_backed_fact",
      "expected_oracle": "contract_and_trace",
      "does_not_contain_private_data": true
    },
    {
      "scenario_id": "partial_capture_public_001",
      "fixture": "conversations/partial_capture_public_001.json",
      "represents_private_failure_class": "partial_receipt_full_ack",
